{
  "name": "172x-data-intel-mvp-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "AppAgent", "class_name": "MvpAppAgent" },
      { "name": "PlannerBudget", "class_name": "PlannerBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MvpAppAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["PlannerBudget"] }
  ],
  "services": [{ "binding": "TOOLS", "service": "172x-data-intel-m2-tools" }],
  "ai": { "binding": "AI" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "RUNTIME_MODE": "deployed",
    "TOOLS_BUILD_REVISION": "",
    "TOOLS_WORKER_VERSION_ID": ""
  }
}
