{
  "name": "172x-data-intel-m2-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": { "RUNTIME_MODE": "deployed" },
  "services": [{ "binding": "TOOLS", "service": "172x-data-intel-m2-tools" }],
  "durable_objects": { "bindings": [{ "name": "ProofAgent", "class_name": "ProofAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProofAgent"] }]
}
